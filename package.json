{
  "name": "copilot-adoption-evidence-console",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-bound product adoption operations console",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format:check": "prettier --check .",
    "start": "next start",
    "lint": "eslint .",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mutation": "node scripts/run-mutation-control.mjs",
    "test:e2e": "playwright test",
    "test:quality": "npm run test && npm run typecheck && npm run lint && npm run build",
    "verify:generated-clean": "git diff --exit-code -- next-env.d.ts tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
